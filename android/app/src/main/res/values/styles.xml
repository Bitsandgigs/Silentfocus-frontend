<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. Follows the system light/dark setting (like the
         React Native screens do) so the very first window frame, the status/
         navigation bars and native dialogs match the app instead of flashing white. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@drawable/sf_launch_window</item>
        <item name="android:colorBackground">@color/sf_launch_background</item>
        <item name="android:textColor">@color/sf_default_text</item>
        <item name="colorAccent">#FF5733</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/sf_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/sf_light_bars</item>
        <item name="android:statusBarColor">@color/sf_launch_bar</item>
        <item name="android:navigationBarColor">@color/sf_launch_bar</item>
        <item name="colorPrimaryDark">@color/sf_launch_bar</item>
        <!-- Android 12+ system splash: plain launch-coloured surface, no icon circle. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/sf_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/sf_splash_icon</item>
    </style>

</resources>
